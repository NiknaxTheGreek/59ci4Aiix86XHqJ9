# ---------------------------------------------------------------------------
# MonReader historical submission — OPTIONAL local settings
# ---------------------------------------------------------------------------
#
# Copy this file to .env at the repository root if you want local overrides.
# Never commit .env or any API key.
#

# Optional explicit repository root.
MONREADER_REPO_ROOT=

# Optional path to a local MonReader dataset checkout/extraction.
# Report mode does not require the dataset.
MONREADER_DATA_ROOT=

# ---------------------------------------------------------------------------
# W&B — disabled by default
# ---------------------------------------------------------------------------

MONREADER_ENABLE_WANDB=0
MONREADER_WANDB_PROJECT=monreader-historical-repro
MONREADER_WANDB_ENTITY=
MONREADER_WANDB_GROUP=
MONREADER_WANDB_TAGS=historical,pre-v2

# W&B reads credentials from WANDB_API_KEY or your local `wandb login`.
WANDB_API_KEY=
WANDB_MODE=disabled

# Extra safety gates. These must be set explicitly before any new sweep or
# agent execution can occur.
MONREADER_CREATE_NEW_SWEEP=0
MONREADER_RUN_WANDB_AGENT=0
MONREADER_WANDB_AGENT_COUNT=1
