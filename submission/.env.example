# Optional path to a local MonReader dataset checkout/extraction.
MONREADER_DATA_ROOT=

# Opt-in W&B integration. Report mode works with this disabled.
MONREADER_ENABLE_WANDB=0
MONREADER_WANDB_PROJECT=monreader-historical-repro
MONREADER_WANDB_ENTITY=
MONREADER_WANDB_GROUP=
MONREADER_WANDB_TAGS=historical,pre-v2

# W&B reads credentials from WANDB_API_KEY or your local wandb login.
WANDB_API_KEY=
WANDB_MODE=disabled
